{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://quick-cart-server-five.vercel.app/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://quick-cart-server-five.vercel.app/auth/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
